{
  "agent_config": {
    "agent_name": "Sales Agent",
    "agent_welcome_message": "Hello {{customer_name}}, this is an assistant calling from {{business_name}}. Do you have a minute?",
    "webhook_url": null,
    "agent_type": "other",
    "tasks": [
      {
        "task_type": "conversation",
        "tools_config": {
          "llm_agent": {
            "agent_type": "simple_llm_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "openai",
              "family": "openai",
              "model": "gpt-4.1",
              "max_tokens": 150,
              "temperature": 0.7,
              "request_json": false
            }
          },
          "synthesizer": {
            "provider": "elevenlabs",
            "provider_config": {
              "voice": "Nila",
              "voice_id": "V9LCAAi4tTlqe9JadbCo",
              "model": "eleven_turbo_v2_5"
            },
            "stream": true,
            "buffer_size": 250,
            "audio_format": "wav"
          },
          "transcriber": {
            "provider": "deepgram",
            "model": "nova-3",
            "language": "en",
            "stream": true,
            "sampling_rate": 16000,
            "encoding": "linear16",
            "endpointing": 500
          },
          "input": { "provider": "plivo", "format": "wav" },
          "output": { "provider": "plivo", "format": "wav" }
        },
        "toolchain": {
          "execution": "parallel",
          "pipelines": [["transcriber", "llm", "synthesizer"]]
        },
        "task_config": {
          "hangup_after_silence": 20,
          "call_terminate": 600,
          "voicemail": false,
          "ambient_noise": false,
          "backchanneling": false,
          "number_of_words_for_interruption": 2
        }
      }
    ]
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": ""
    }
  }
}
