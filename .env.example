# Public URL of this app (Razorpay sends customers back here; Bolna sends call updates here if https)
APP_BASE_URL=http://localhost:8000

# --- Database -------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (works on IPv4 hosts like Render).
# Looks like postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty to use a local SQLite file (DATABASE_PATH) for development.
DATABASE_URL=
DATABASE_PATH=data/accounts.db
# Lead lists and call results are kept this many days after a campaign finishes, then deleted
RESULTS_RETENTION_DAYS=7

# --- Razorpay (payments) -------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys first, then rzp_live_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRICE_CURRENCY=inr
# Pay-as-you-go rate in paise per minute of answered calls (1000 = Rs 10/min, billed per second)
PRICE_PER_MINUTE_PAISE=1000
# Smallest wallet top-up in paise (10000 = Rs 100)
MIN_TOPUP_PAISE=10000
# Campaigns can't start, and the next lead isn't called, while the wallet is below this (2000 = Rs 20)
LOW_BALANCE_PAISE=2000

# --- Sign-in (Supabase Auth: email + password, email confirmation, password reset, Google) ---
# Supabase: Project Settings -> API -> Project URL and the "anon public" key (safe to show in the browser).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Bolna (AI calls) ------------------------------------------------------------
BOLNA_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
# Caller ID number connected in Bolna (E.164), optional
BOLNA_FROM_NUMBER=
# LLM and telephony defaults for the agent created for each campaign
BOLNA_AGENT_TEMPLATE=app/bolna_agent_template.json
# The AI voice used for every call (the first entry in this file)
VOICES_FILE=app/voices.json

# --- Campaign limits -------------------------------------------------------------
MAX_LEADS_PER_CAMPAIGN=500
MAX_CONCURRENT_CALLS=3
# Country code prepended to numbers without one
DEFAULT_COUNTRY_CODE=91
# A call with no final status after this long is marked as timed out
CALL_TIMEOUT_MINUTES=30
WORKER_INTERVAL_SECONDS=5
