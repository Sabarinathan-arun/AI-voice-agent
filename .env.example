# Public URL of this app (Razorpay sends customers back here; Bolna sends call updates here if https)
APP_BASE_URL=http://localhost:8000

# Customer accounts, wallets and usage history (SQLite file; lead lists are never stored here)
DATABASE_PATH=data/accounts.db

# --- Razorpay (payments) -------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys first, then rzp_live_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRICE_CURRENCY=inr
# Pay-as-you-go rate in paise per minute of answered calls (1000 = Rs 10/min, billed per second)
PRICE_PER_MINUTE_PAISE=1000
# Smallest wallet top-up in paise (10000 = Rs 100)
MIN_TOPUP_PAISE=10000

# --- Bolna (AI calls) ------------------------------------------------------------
BOLNA_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
# Caller ID number connected in Bolna (E.164), optional
BOLNA_FROM_NUMBER=
# LLM and telephony defaults for the agent created for each campaign
BOLNA_AGENT_TEMPLATE=app/bolna_agent_template.json
# AI voices customers can choose from
VOICES_FILE=app/voices.json

# --- Campaign limits -------------------------------------------------------------
MAX_LEADS_PER_CAMPAIGN=500
MAX_CONCURRENT_CALLS=3
# Country code prepended to numbers without one
DEFAULT_COUNTRY_CODE=91
# A call with no final status after this long is marked as timed out
CALL_TIMEOUT_MINUTES=30
WORKER_INTERVAL_SECONDS=5
