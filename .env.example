# Public URL of this app (used for payment redirects and the Bolna webhook)
APP_BASE_URL=http://localhost:8000

# SQLite file for temporary campaign data
DATABASE_PATH=data/app.db

# --- Payment ---------------------------------------------------------------
# "mock" (no real charge, for local testing) or "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price per campaign in the currency's minor unit (e.g. 99900 = 999.00)
PRICE_AMOUNT=99900
PRICE_CURRENCY=inr
PRODUCT_NAME=AI Sales Calling Campaign

# --- Bolna -----------------------------------------------------------------
# Set BOLNA_MOCK=true to simulate calls without a Bolna account
BOLNA_MOCK=true
BOLNA_API_KEY=
BOLNA_API_BASE=https://api.bolna.ai
# Optional caller ID purchased/connected in Bolna (E.164)
BOLNA_FROM_NUMBER=
# JSON template used to create the voice agent (see app/bolna_agent_template.json)
BOLNA_AGENT_TEMPLATE=app/bolna_agent_template.json

# --- Campaign limits ---------------------------------------------------------
MAX_LEADS_PER_CAMPAIGN=500
MAX_CONCURRENT_CALLS=3
# Country code prepended to numbers without one
DEFAULT_COUNTRY_CODE=91
# A call with no final status after this long is marked as timed out
CALL_TIMEOUT_MINUTES=30
WORKER_INTERVAL_SECONDS=5

# --- Automatic deletion ------------------------------------------------------
# Campaign data (leads, transcripts, summaries) is deleted this long after payment
RETENTION_HOURS=72
# Unpaid campaigns are deleted after this long
UNPAID_RETENTION_HOURS=24
